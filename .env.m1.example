# Copy to .env.m1. Compose uses separate ports so the standard Docker stack can
# stay running while you compare its CPU worker with the native M1 worker.
HOST_BIND_ADDRESS=127.0.0.1
LOUNGE_CONTROL_PORT=18100
VIDEO_STREAM_PORT=18103
MOCK_HOTEL_PORT=18102
NATIVE_FACE_WORKER_PORT=18101
LOUNGE_CONTROL_URL=http://127.0.0.1:18100
FACE_EXECUTION_PROVIDER=coreml
COREML_COMPUTE_UNITS=CPUAndGPU
COREML_PROFILE_COMPUTE_PLAN=false
