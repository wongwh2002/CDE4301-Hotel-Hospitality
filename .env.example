# ==============================================================================
# Hotel Smart-Glasses POC - Local Environment Configuration
# ==============================================================================
#
# IMPORTANT SECURITY & NETWORKING NOTE:
# This stack is a local POC scaffold for testing on a single development machine
# or across a dedicated, trusted private router / phone hotspot.
#
# DO NOT bind this stack to public interfaces or configure internet port-forwarding.
# Keep access restricted to the local machine (127.0.0.1) or your laptop's private LAN IP
# (e.g., 192.168.1.50) on the dedicated test Wi-Fi network.

# Host bind address for published service ports.
# Default: 127.0.0.1 (local loopback only).
# For testing with physical phones on a private router/hotspot, change this to
# your laptop's private LAN IP (e.g., 192.168.x.x).
HOST_BIND_ADDRESS=127.0.0.1

# To publish the dashboard/WebSocket port on localhost as well as the LAN IP,
# uncomment this after setting HOST_BIND_ADDRESS to the laptop's private LAN IP.
#COMPOSE_FILE=compose.yaml:compose.loopback.yaml

# Published service host ports
LOUNGE_CONTROL_PORT=8000
FACE_WORKER_PORT=8001
VIDEO_STREAM_PORT=8003
MOCK_HOTEL_PORT=8002

# Temporary POC device WebSocket credential.
DEVICE_AUTH_TOKEN=gedi-4301

# Separate service-to-service credential for face-worker and lounge-control.
INTERNAL_API_TOKEN=

# In-memory active cohort presence TTL (seconds)
# Time after which inactive guest entries expire from the active recognition set
COHORT_EXPIRY_SECONDS=7200

# Stable identity confirmation: require two matching observations in the
# rolling three-frame window before showing a guest identity.
FACE_STABLE_FRAMES=3
FACE_STABLE_MATCHES=2

# Set to DEBUG for per-frame queue, detector, match-vote, and callback logs.
# Detailed logs include opaque IDs and scores, never guest names or image bytes.
FACE_WORKER_LOG_LEVEL=INFO

# Execution provider. Docker stays on CPU by default. On Apple Silicon, the
# opt-in native-worker guide can set FACE_EXECUTION_PROVIDER=coreml.
FACE_EXECUTION_PROVIDER=cpu
COREML_COMPUTE_UNITS=CPUAndGPU
COREML_PROFILE_COMPUTE_PLAN=false

# Lounge-control's per-stream face result cache and device snapshot cadence
# A stable match expires after 5 seconds without a worker refresh.
DETECTION_TTL_SECONDS=5
DETECTION_SET_INTERVAL_SECONDS=1

# Face worker bounded queue settings
MAX_FRAME_SIZE_BYTES=5242880
QUEUE_MAXSIZE=5
# Reject capture timestamps older than this and queued frames waiting longer.
MAX_FRAME_AGE_SECONDS=2.0
MAX_FRAME_QUEUE_AGE_SECONDS=1.0

# Retry pending candidate templates and recover active templates after worker restart.
CANDIDATE_RECONCILE_INTERVAL_SECONDS=5

# Container-to-container internal URLs (used inside Docker Compose)
MOCK_HOTEL_URL=http://mock-hotel:8002
FACE_WORKER_URL=http://face-worker:8001
LOUNGE_CONTROL_URL=http://lounge-control:8000
