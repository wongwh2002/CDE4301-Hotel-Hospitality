{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotel-hospitality.internal/contracts/v1/match-event.schema.json",
  "title": "MatchEvent",
  "description": "Internal face matching event from face-worker to lounge-control (opaque candidate ID only, zero PII)",
  "type": "object",
  "required": [
    "stream_id",
    "track_id",
    "status",
    "matched_at"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Opaque candidate identifier (strictly no names, guest refs, or PII)"
    },
    "stream_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Stream identifier where match occurred"
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Optional device identifier"
    },
    "track_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Face track identifier within the stream"
    },
    "status": {
      "type": "string",
      "enum": ["stable_match", "unconfirmed", "no_match"],
      "description": "Matching outcome status"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Match confidence score"
    },
    "matched_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of match derivation"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "stable_match"}}, "required": ["status"]},
      "then": {"required": ["candidate_id"]}
    }
  ]
}
