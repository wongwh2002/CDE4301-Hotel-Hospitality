{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotel-hospitality.internal/contracts/v1/tap-event.schema.json",
  "title": "TapEvent",
  "description": "Card reader access controller tap event sent to lounge-control",
  "type": "object",
  "required": [
    "event_id",
    "reader_id",
    "guest_ref",
    "event_type",
    "occurred_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Unique event identifier for idempotency"
    },
    "reader_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Identifier of the card reader / access controller"
    },
    "guest_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Hotel-internal opaque guest reference token"
    },
    "event_type": {
      "type": "string",
      "enum": ["entry", "exit"],
      "description": "Type of access event"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of when the tap occurred"
    }
  },
  "additionalProperties": false
}
